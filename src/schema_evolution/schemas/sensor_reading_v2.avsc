{
  "type": "record",
  "name": "SensorReading",
  "namespace": "events.sensors",
  "doc": "One reading from an environmental sensor. Version 2 adds two optional fields, each with a default, so it is compatible in both directions.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "device_id", "type": "string"},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "temperature_c", "type": "double"},
    {"name": "humidity_pct", "type": "double"},
    {"name": "battery_pct", "type": ["null", "double"], "default": null},
    {"name": "firmware", "type": "string", "default": "unknown"}
  ]
}
